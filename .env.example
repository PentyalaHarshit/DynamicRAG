# ==========================================
# DynamicRAG & OmniKnowledge Environment Variables
# ==========================================

# Server Port
PORT=8000

# LLM Providers (Optional / Fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Web Search API (Google Custom Search Engine - Optional, DDGS fallback used if omitted)
GOOGLE_API_KEY=your_google_cloud_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# HuggingFace Hub Token (For higher rate limits on Cross-Encoder & Embedding downloads)
HF_TOKEN=hf_your_huggingface_token_here

# AWS Deployment Credentials (For CI/CD and AWS CLI deployment)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
